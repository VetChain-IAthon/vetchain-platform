# Copia este archivo como .env y completa los valores. NUNCA subas el .env al repositorio.

# Base de datos. Local: SQLite. En Render: la cadena de conexión de Neon (postgresql://...).
DATABASE_URL=sqlite:///./vetchain.db

# Clave para firmar las sesiones (JWT). En producción usa un valor largo y aleatorio.
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
JWT_EXPIRE_MINUTES=480

# Gemini API (capa gratuita). Clave en https://aistudio.google.com/apikey. Vacía = sin IA generativa (texto de reserva).
GEMINI_API_KEY=
# Modelo de Gemini; revisa los disponibles en AI Studio.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=20  # por intento; se reintenta hasta 3 veces
# Resend: clave de API. Verifica el dominio remitente en Resend. Vacía = los correos se simulan.
RESEND_API_KEY=

# Para usar un @gmail.com como origen: activa la verificación en dos pasos y crea una contraseña de aplicación.
# La cuenta debe coincidir con el correo de origen guardado en Ajustes › Correo.
GMAIL_SMTP_EMAIL=
GMAIL_SMTP_APP_PASSWORD=

# Google OAuth: cada usuario conecta su Gmail con Google, sin contraseña de aplicación.
# Crea credenciales de aplicación web en Google Cloud y habilita Gmail API.
# Registra GOOGLE_OAUTH_REDIRECT_URI como URI de redirección autorizada.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback
# Genera una clave con: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
GOOGLE_OAUTH_TOKEN_KEY=
FRONTEND_URL=http://localhost:3000

# Orígenes permitidos para el frontend, separados por coma.
CORS_ORIGINS=http://localhost:3000

# Ruta del modelo de predicción (XGBoost) dentro del repositorio.
MODEL_PATH=models/model.json

# Seed de usuarios: python -m scripts.seed_users (o --random para generarlos y guardarlos aquí). Contraseñas de al menos 8 caracteres; nunca las subas al repo.
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
SEED_MANAGER_NAME=
SEED_MANAGER_PHONE=
SEED_SALESPERSON_EMAIL=
SEED_SALESPERSON_PASSWORD=
SEED_SALESPERSON_NAME=
SEED_SALESPERSON_PHONE=

# Código de vendedor de Defontana (tabla salespeople), por ejemplo 002
SEED_SALESPERSON_CODE=
